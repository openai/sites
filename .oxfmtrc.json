{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/",
    "node_modules/",
    "coverage/",
    "pnpm-lock.yaml",
    ".pre-commit-config.yaml",
    "SECURITY.md"
  ]
}
