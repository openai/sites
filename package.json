{
  "name": "@openai/sites",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "lint": "oxlint --ignore-pattern \"packages/create-sites/templates/**\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "changeset": "changeset",
    "changeset:check": "changeset status --since=origin/main"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "5.9.3",
    "vitest": "4.1.7"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.1.2"
}
