{
  "name": "@openai/sites-vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for packaging OpenAI Sites deployment metadata.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openai/sites.git",
    "directory": "packages/sites-vite-plugin"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "vite": "8.0.16"
  }
}
